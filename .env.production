# Public Supabase credentials for production builds.
#
# These are NEXT_PUBLIC_* values, so Next.js inlines them into the static
# export (`output: "export"`) at BUILD time. `.env.local` is git-ignored and
# never reaches CI / a fresh build machine, which is why the live site showed
# "Authentication isn't configured yet". This committed file guarantees every
# production build (Cloudflare Pages, or a local `next build` you upload) bakes
# the keys in.
#
# The ANON key is a *publishable* key — it is meant to be exposed in the browser
# and is already shipped in the client bundle. Security is enforced by Supabase
# Row-Level Security, not by hiding this key. Do NOT put the service_role key
# here.
NEXT_PUBLIC_SUPABASE_URL=https://ygpcbvmrcvbgjrhvvggf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlncGNidm1yY3ZiZ2pyaHZ2Z2dmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI0NjM4NTUsImV4cCI6MjA5ODAzOTg1NX0.IV0cWL1GNN1WsF2sEUh2yhPsV9cduUDUSsIgS05uc6U
