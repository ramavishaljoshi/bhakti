# Cloudflare Pages cache policy (addresses "Use efficient cache lifetimes").
# Hashed build output is content-addressed, so it is safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts emitted by next/font are also content-hashed.
/_next/static/media/*
  Cache-Control: public, max-age=31536000, immutable

# Images live in /assets. They change rarely; cache for 30 days.
/assets/*
  Cache-Control: public, max-age=2592000

# Site icons / favicons — cache a week. (MIME types are set from the extension
# by Cloudflare Pages; these blocks add caching + ensure Google can refetch.)
/favicon.ico
  Cache-Control: public, max-age=604800
/icon.svg
  Cache-Control: public, max-age=604800
/favicon-16x16.png
  Cache-Control: public, max-age=604800
/favicon-32x32.png
  Cache-Control: public, max-age=604800
/favicon-48x48.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/og-image.png
  Cache-Control: public, max-age=604800

# Manifest & machine-readable feeds — explicit content types.
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400
/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=86400
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
