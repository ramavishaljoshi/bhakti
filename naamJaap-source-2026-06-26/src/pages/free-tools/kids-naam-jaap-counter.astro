---
import KidsNaamJaapCounter from "../../components/KidsNaamJaapCounter";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import "../../styles/global.css";

const title = "Kids Naam Jaap Counter - Cute 108 Name Bucket Game";
const description =
  "A free kids-only Naam Jaap counter where children fill a cute bhakti bucket with flowers, stars, makhan or lotus rewards as they chant 108 names.";
const canonical = new URL(Astro.url.pathname, Astro.site || "https://naamjapa.com").toString();

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Kids Naam Jaap Counter",
  applicationCategory: "LifestyleApplication",
  operatingSystem: "Web",
  url: canonical,
  description,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  audience: {
    "@type": "Audience",
    audienceType: "Children with parent or guardian guidance",
  },
  featureList: [
    "108-count kids jaap counter",
    "Bhakti bucket filling animation",
    "Radha Krishna inspired child-friendly artwork",
    "Simple mantra choices",
    "Sound and chime feedback",
    "Local-only saved completed buckets",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "How is this different from an adult jaap counter?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Instead of showing a serious mala dashboard, the kids counter uses a simple story: every naam adds a blessing and 108 names fill a bhakti bucket.",
      },
    },
    {
      "@type": "Question",
      name: "Does the kids counter save data online?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. Completed buckets are saved only in the browser localStorage on the same device.",
      },
    },
    {
      "@type": "Question",
      name: "Which mantras are included?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Simple options include Radhe Radhe, Hare Krishna, Ram Ram, Om Namah Shivaya and Waheguru.",
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#bde7ff" />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="/og-naam-jaap.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;600;700;800;900&family=Noto+Serif+Devanagari:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body class="kids-tool-body">
    <div class="page-shell">
      <div class="deity-watermark" aria-hidden="true">राधे</div>
      <SiteHeader section="Kids Counter" note="Cute 108 naam game · parent friendly · local-only" />

      <main class="content-layer">
        <KidsNaamJaapCounter client:load />

        <section class="seo-section" aria-labelledby="kids-seo-title">
          <div class="seo-inner">
            <p class="seo-eyebrow">Free kids spiritual tool</p>
            <h1 id="kids-seo-title">Kids Naam Jaap Counter with a cute 108-name bucket game</h1>
            <p class="lede">
              Most jaap counters are designed for adults. This one is made for children: easy words,
              big buttons, a cute devotional world, and a simple idea that makes sense to a child.
              Say one naam, add one blessing. At 108, the bucket is full.
            </p>

            <h2>Why a kids counter needs a different design</h2>
            <p>
              Children do not need a heavy dashboard with stats first. They need a clear story,
              friendly feedback, and a visible reward. The bucket makes 108 feel concrete: empty at
              the start, slowly filling with flowers, stars, makhan or lotus blessings.
            </p>

            <div class="seo-grid">
              <article class="seo-card">
                <h3>Simple story</h3>
                <p>Every naam fills the bhakti bucket. The child can see progress without reading complex numbers.</p>
              </article>
              <article class="seo-card">
                <h3>Parent guided</h3>
                <p>Parents can read the mantra line and the child taps after saying one naam.</p>
              </article>
              <article class="seo-card">
                <h3>Private by default</h3>
                <p>Completed buckets save only on the same device in browser localStorage.</p>
              </article>
            </div>

            <h2>How to use with a child</h2>
            <ol>
              <li>Choose a simple naam like Radhe Radhe, Ram Ram or Hare Krishna.</li>
              <li>Tell the child: every naam adds one blessing to the bucket.</li>
              <li>Tap the big bucket after each chant.</li>
              <li>At 108, celebrate one full bhakti bucket.</li>
              <li>Keep the session short and happy. Devotion should feel warm, not forced.</li>
            </ol>

            <h2>Related tools</h2>
            <div class="related-tools">
              <a class="related-link" href="/free-tools/naam-jaap-counter/">
                <strong>Naam Jaap Counter</strong>
                <span>The main adult 108 mala counter.</span>
              </a>
              <a class="related-link" href="/free-tools/daily-affirmations/">
                <strong>Daily Affirmations</strong>
                <span>Positive mood uplift with naam anchors.</span>
              </a>
            </div>

            <SiteFooter />
          </div>
        </section>
      </main>
    </div>
    <style is:global>
      .kids-tool-body .deity-watermark {
        display: none;
      }

      @media (max-width: 640px) {
        .kids-tool-body .site-header {
          position: absolute;
          inset: 0 0 auto;
          z-index: 5;
          padding: 8px 10px;
        }

        .kids-tool-body .brand {
          border-radius: 999px;
          padding: 7px 10px;
          color: #3b2818;
          background: rgba(255, 255, 255, 0.58);
          box-shadow: 0 10px 28px rgba(83, 58, 25, 0.12);
          font-size: 0.94rem;
        }

        .kids-tool-body .brand-mark {
          width: 8px;
          height: 8px;
          background: #ff87b5;
        }

        .kids-tool-body .mobile-nav summary {
          width: 38px;
          height: 38px;
          border-color: rgba(120, 83, 42, 0.18);
          background: rgba(255, 255, 255, 0.58);
          box-shadow: 0 10px 28px rgba(83, 58, 25, 0.12);
        }

        .kids-tool-body .mobile-nav summary span {
          background: #3b2818;
        }

        .kids-tool-body .content-layer {
          padding-top: 0;
        }
      }
    </style>
  </body>
</html>
