---
type Props = { active?: "counter" | "journey" | "milestones" | "goals" };
const { active = "journey" } = Astro.props;

const tabs = [
  { id: "counter", label: "Counter", href: "/free-tools/naam-jaap-counter-modern/", icon: "counter" },
  { id: "journey", label: "Journey", href: "/free-tools/japa-journey/", icon: "journey" },
  { id: "milestones", label: "Milestones", href: "/free-tools/japa-milestones/", icon: "milestones" },
  { id: "goals", label: "Goals", href: "/free-tools/japa-goals/", icon: "goals" },
];
---

<nav class="tracker-nav" aria-label="Japa tracker">
  <div class="tracker-nav-inner">
    {tabs.map((tab) => (
      <a
        href={tab.href}
        class:list={["tracker-tab", { "is-active": tab.id === active }]}
        aria-current={tab.id === active ? "page" : undefined}
      >
        <span class="tracker-ico" aria-hidden="true">
          {tab.icon === "counter" && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9" stroke-dasharray="2 3"></circle>
              <path d="M12 7v5l3 2"></path>
            </svg>
          )}
          {tab.icon === "journey" && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 17l6-6 4 4 7-7"></path>
              <path d="M17 8h4v4"></path>
            </svg>
          )}
          {tab.icon === "milestones" && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="9" r="5"></circle>
              <path d="M9 13.5L7.5 21 12 18.5 16.5 21 15 13.5"></path>
            </svg>
          )}
          {tab.icon === "goals" && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9"></circle>
              <circle cx="12" cy="12" r="5"></circle>
              <circle cx="12" cy="12" r="1"></circle>
            </svg>
          )}
        </span>
        <span class="tracker-label">{tab.label}</span>
      </a>
    ))}
  </div>
</nav>

<style>
  .tracker-nav {
    position: sticky;
    top: 8px;
    z-index: 5;
    width: min(720px, 100%);
    margin: 4px auto 18px;
    padding: 0 clamp(10px, 2vw, 24px);
  }

  .tracker-nav-inner {
    display: flex;
    gap: 6px;
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: rgba(8, 14, 26, 0.82);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(16px);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tracker-nav-inner::-webkit-scrollbar {
    display: none;
  }

  .tracker-tab {
    flex: 1 1 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: max-content;
    padding: 11px 14px;
    border-radius: 13px;
    color: var(--ink-dim);
    text-decoration: none;
    font-weight: 800;
    font-size: 0.92rem;
    white-space: nowrap;
    transition: background 0.18s ease, color 0.18s ease;
  }

  .tracker-tab:hover,
  .tracker-tab:focus-visible {
    color: var(--ink);
    background: rgba(255, 255, 255, 0.05);
    outline: none;
  }

  .tracker-tab.is-active {
    color: #fff;
    background: linear-gradient(135deg, #7c6cf0, #5a48d6);
    box-shadow: 0 10px 26px rgba(90, 72, 214, 0.4);
  }

  .tracker-ico {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .tracker-ico svg {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 560px) {
    .tracker-tab {
      flex: 0 0 auto;
      padding: 10px 14px;
    }
    .tracker-label {
      font-size: 0.86rem;
    }
  }
</style>
